# API Configuration
# Base URL for the backend API
# In development, this should point to your local backend server
# In production, this will be set to the deployed backend URL
VITE_API_BASE_URL=http://localhost:3001/api

# Backend URL (without /api path)
VITE_BACKEND_URL=http://localhost:3001

# Frontend URL
VITE_FRONTEND_URL=http://localhost:3000

# WebSocket URL (if needed in future)
VITE_WS_URL=ws://localhost:3001/ws

# Application Configuration
VITE_NODE_ENV=development
VITE_PORT=3000
VITE_TRUST_PROXY=false
VITE_LOG_LEVEL=info

# Feature Flags
VITE_NEXT_TELEMETRY_DISABLED=1
VITE_ENABLE_SOURCE_MAPS=true
VITE_HEALTHCHECK_PATH=/healthz
VITE_FEATURE_FLAGS={}
VITE_EXPERIMENTS_ENABLED=false
